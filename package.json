{
  "name": "metaide",
  "version": "0.3.6",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x",
    "pnpm": "11.x"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:solo": "METAIDE_USERDATA_DIR=/tmp/metaide-dev-userdata electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "rebuild:electron": "electron-rebuild -f -o node-pty",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "test": "ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run",
    "test:terminal-artifacts": "node --test tests/packaging/check-desktop-terminal-artifacts.mjs",
    "test:watch": "ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs",
    "test:e2e": "playwright test",
    "test:e2e:full": "electron-vite build && playwright test",
    "mock-claude": "node scripts/mock-claude.mjs",
    "dist:mac": "electron-vite build && electron-builder --mac --arm64 --x64 && pnpm rebuild:electron",
    "dist:mac-arm": "electron-vite build && electron-builder --mac --arm64 && pnpm rebuild:electron",
    "dist:win": "electron-vite build && electron-builder --win --x64 && pnpm rebuild:electron",
    "dist:linux": "electron-vite build && electron-builder --linux --x64 && pnpm rebuild:electron",
    "dist:all": "node scripts/dist-all.mjs && pnpm rebuild:electron",
    "gen:icons": "node scripts/gen-icons.mjs",
    "postinstall": "install-electron && (test -d node_modules/node-pty/prebuilds/darwin-arm64 && chmod +x node_modules/node-pty/prebuilds/darwin-arm64/spawn-helper || true) && pnpm rebuild:electron"
  },
  "build": {
    "appId": "com.metalogix.metaide",
    "productName": "MetaLogix IDE",
    "afterPack": "scripts/sign-macos-bundle.mjs",
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "resources/package.json",
        "to": "package.json"
      }
    ],
    "files": [
      "out/**/*",
      "resources/ghostty/**/*",
      "resources/claude-hooks/**/*",
      "migrations/**/*",
      "package.json",
      "!**/node_modules/*/{CHANGELOG.md,README.md,readme.md,test,__tests__,tests,powered-test,example,examples,*.d.ts,tsconfig*.json}",
      "!**/*.map"
    ],
    "asarUnpack": [
      "**/*.node",
      "node_modules/better-sqlite3/**",
      "node_modules/node-pty/**"
    ],
    "fileAssociations": [
      {
        "ext": "md",
        "name": "Markdown",
        "role": "Editor"
      },
      {
        "ext": "markdown",
        "name": "Markdown",
        "role": "Editor"
      },
      {
        "ext": "py",
        "name": "Python Source File",
        "role": "Editor"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "dmg": {
      "sign": false,
      "writeUpdateInfo": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-${arch}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-serialize": "^0.13.0",
    "@xterm/addon-unicode11": "^0.8.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/headless": "^5.5.0",
    "@xterm/xterm": "^5.5.0",
    "better-sqlite3": "13.2.0",
    "chokidar": "^3.6.0",
    "electron-log": "^5.4.4",
    "fuse.js": "^7.0.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.19.1",
    "keytar": "^7.9.0",
    "markdown-it": "^14.3.3",
    "mermaid": "11.17.2",
    "motion": "14.0.0",
    "node-pty": "^1.0.0",
    "pdfjs-dist": "^6.5.438",
    "qrcode-generator": "^2.0.4",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "socket.io-client": "^4.8.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@gespenst/core": "0.2.0",
    "@gespenst/xterm": "0.2.0",
    "@noble/hashes": "^2.4.0",
    "@playwright/test": "^1.47.0",
    "@roamhq/wrtc": "^0.10.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/ui": "^4.1.12",
    "autoprefixer": "^10.4.0",
    "effect": "^4.1.4",
    "electron": "43.8.12",
    "electron-builder": "^26.0.0",
    "electron-vite": "^3.1.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "26.1.0",
    "postcss": "^8.5.23",
    "prettier": "^3.3.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "vite": "^6.4.6",
    "vitest": "^4.1.12"
  }
}
