/**
 * Builds the terminal page for the WebView: src/terminal/bridge.ts bundled with xterm.js into one
 * script, inlined with the stylesheet into a single HTML string (works offline, no CDN). Runs on
 * postinstall and before `expo start`; the output is git-ignored.
 */
import { build } from 'esbuild';
import { readFileSync, writeFileSync } from 'node:fs';
import { createRequire } from 'node:module';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';

const root = join(dirname(fileURLToPath(import.meta.url)), '..');
const require = createRequire(import.meta.url);

const bundle = await build({
  entryPoints: [join(root, 'src/terminal/bridge.ts')],
  bundle: true,
  format: 'iife',
  platform: 'browser',
  target: 'es2020',
  minify: true,
  legalComments: 'none',
  write: false,
});
// A literal "</script" inside inline JS would end the element early.
const script = bundle.outputFiles[0]!.text.replace(/<\/script/gi, '<\\/script');
const css = readFileSync(require.resolve('@xterm/xterm/css/xterm.css'), 'utf8');

const html = `<!doctype html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
<style>${css}
html, body { margin: 0; height: 100%; background: #0d1014; overflow: hidden; overscroll-behavior: none; -webkit-text-size-adjust: 100%; }
#t { position: absolute; top: 0; right: 0; bottom: 0; left: 0; padding: 4px 2px 0 6px; }
.xterm .xterm-viewport { background-color: transparent !important; }
</style>
</head>
<body>
<div id="t"></div>
<script>${script}</script>
</body>
</html>`;

writeFileSync(
  join(root, 'src/ui/terminalHtml.generated.ts'),
  `// Generated by scripts/build-terminal-html.mts. Do not edit.\nexport const TERMINAL_HTML = ${JSON.stringify(html)};\n`,
);
console.log(`terminal html: ${(html.length / 1024).toFixed(0)} KB`);
