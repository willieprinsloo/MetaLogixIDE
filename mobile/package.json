{
  "name": "metaide-mobile",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.5.2",
    "@react-navigation/native-stack": "^7.21.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "expo": "~58.0.25",
    "expo-build-properties": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-dev-client": "~58.0.20",
    "expo-secure-store": "~58.0.3",
    "expo-speech-recognition": "^58.0.1",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-get-random-values": "^2.1.0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-tcp-socket": "^6.4.3",
    "react-native-webrtc": "^155.0.1",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "gen:terminal": "node scripts/build-terminal-html.mjs",
    "postinstall": "node scripts/build-terminal-html.mjs",
    "prestart": "node scripts/build-terminal-html.mjs",
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "cd .. && ELECTRON_RUN_AS_NODE=1 node_modules/.bin/electron node_modules/vitest/vitest.mjs run mobile/src/core",
    "probe": "cd .. && node_modules/.bin/esbuild mobile/scripts/probe.ts --bundle --platform=node --format=esm --external:@roamhq/wrtc --outfile=.probe-tmp.mjs --log-level=warning && node .probe-tmp.mjs"
  },
  "private": true
}
