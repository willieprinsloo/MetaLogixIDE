{
  "expo": {
    "name": "MetaLogix IDE",
    "slug": "metaide-mobile",
    "scheme": "metaide",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.metalogix.metaide.mobile",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Connects directly to your paired machines when they are on the same network.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Dictate text into a terminal by voice."
      },
      "appleTeamId": "6BJ3P4UXV7"
    },
    "android": {
      "package": "com.metalogix.metaide.mobile",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0d1014",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-secure-store",
      "expo-build-properties",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan the pairing QR code shown on your desktop.",
          "microphonePermission": "Dictate text into a terminal by voice.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Dictate text into a terminal by voice.",
          "speechRecognitionPermission": "Turn your speech into text to type into a terminal."
        }
      ]
    ]
  }
}
